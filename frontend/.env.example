# Copy this file to .env.local (never committed) and fill in your Supabase project's values.
# Supabase dashboard → Project Settings → Data API (URL) and API Keys (publishable key).
# Never put the secret (service_role) key here: every VITE_ value is visible in the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
