# Copy to .env (never committed) and fill in. Read by worker.py.
#
# Supabase: the project URL, and the key agreed with the database owner (Haya). With option A this
# is the SECRET key (sb_secret_...), which has full access to the database: only on the machine that
# runs this service, never in the frontend, a chat or a group.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# 1 = use the BGE-M3 copy already downloaded (no internet check at start-up). Set to 0 for the
# very first run so the model can be downloaded.
HF_HUB_OFFLINE=1

# Only if llm.provider is openrouter in config.yaml (non-confidential SOPs only).
OPENROUTER_API_KEY=
